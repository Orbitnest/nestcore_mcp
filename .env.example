# NestCore Backend Configuration
# NESTCORE_API_URL must point at the NestCore API whose console hosts the
# OAuth callback page — used by the nestcore_login (Google/GitHub/Apple) tool.
NESTCORE_API_URL=https://api.nestcore.io
NESTCORE_API_BASE_PATH=/api
# (The pre-rename ORBITNEST_API_URL / ORBITNEST_API_BASE_PATH are still read as fallbacks.)

# Authentication
# Sign in at runtime with nestcore_admin_signin (email + password) or
# nestcore_login (Google/GitHub/Apple via browser). Tokens are stored in
# ~/.nestcore/credentials.json — no token needs to be set here.

# MCP Server Configuration
MCP_SERVER_NAME=nestcore
LOG_LEVEL=info

# Workspace Configuration (optional, can be detected)
DEFAULT_PROJECT_ID=

# Safety Configuration
ENABLE_SQL_GUARD=true
BLOCK_AUTH_TABLE_MUTATIONS=true

# Cache Configuration
SCHEMA_CACHE_TTL=300000
TOKEN_REFRESH_THRESHOLD=60000
