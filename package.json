{
  "name": "@orbitneststudio/mcp-server",
  "version": "1.5.0",
  "description": "Model Context Protocol server for OrbitNest Studio",
  "main": "dist/index.js",
  "bin": {
    "orbitnest-mcp": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "npm run build && node test/resource-size.mjs"
  },
  "files": [
    "dist/",
    "src/",
    ".env.example",
    ".mcp.json",
    "README.md",
    "tsconfig.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Orbitnest/orbitnest_mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.22.4",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0"
  },
  "keywords": [
    "mcp",
    "orbitnest",
    "model-context-protocol",
    "ai"
  ],
  "author": "OrbitNest Team",
  "license": "MIT"
}
